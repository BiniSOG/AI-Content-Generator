{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Storyboard: the contract between every pipeline stage",
  "type": "object",
  "required": [
    "version",
    "title",
    "logline",
    "audience",
    "language",
    "models",
    "style",
    "characters",
    "shots",
    "music",
    "end_card"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string",
      "minLength": 10
    },
    "audience": {
      "type": "object",
      "required": [
        "who",
        "where",
        "feel"
      ],
      "additionalProperties": false,
      "properties": {
        "who": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "feel": {
          "type": "string"
        }
      }
    },
    "language": {
      "type": "object",
      "required": [
        "narration",
        "subtitles"
      ],
      "additionalProperties": false,
      "properties": {
        "narration": {
          "type": "string",
          "description": "BCP-47 code of the spoken language, e.g. am, en, om, ti"
        },
        "narration_name": {
          "type": "string"
        },
        "subtitles": {
          "enum": [
            "en",
            "am",
            "am+en"
          ],
          "description": "en = English only; am = the narration language only; am+en = narration language on top, English below"
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Model IDs live here, not in code, so a model swap is a storyboard change and invalidates the cache.",
      "required": [
        "text",
        "tts",
        "image"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "tts": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "image_alt": {
          "type": "string"
        },
        "video": {
          "type": "string"
        },
        "music": {
          "type": "string"
        },
        "text_fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tried in order if the text model is overloaded"
        },
        "tts_fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tried in order if the TTS model is overloaded"
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "block",
        "negative"
      ],
      "additionalProperties": false,
      "properties": {
        "block": {
          "type": "string",
          "minLength": 20,
          "description": "Appended to every image prompt"
        },
        "negative": {
          "type": "string"
        },
        "golden_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path of the approved reference image, or null until chosen"
        },
        "setting": {
          "type": "string",
          "minLength": 20,
          "description": "Place and people line put FIRST in every shot prompt (image models weight the start of a prompt most)"
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "real_person"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "real_person": {
            "type": "boolean",
            "description": "If true, ETHICS.md must hold a consent record before generation"
          },
          "ref_seed": {
            "type": "integer"
          },
          "short": {
            "type": "string",
            "minLength": 20,
            "description": "Compact appearance used inside shot prompts (the full description is used for the reference portrait)"
          },
          "ref_framing": {
            "type": "string",
            "minLength": 20,
            "description": "How the reference image is framed (pose, crop, background); default: one full-body figure"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "description": "How many people this character entry is (e.g. 5 for a group); checked on the reference image"
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "cloned": {
          "type": "boolean",
          "const": false
        },
        "check_language": {
          "type": "boolean",
          "description": "Let Gemini listen to every narration line and reject non-narration-language speech (one extra text-model call per line)"
        },
        "tempo": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.5,
          "description": "Speed-up applied to every narration line, pitch kept (no API call)"
        },
        "max_pause_s": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2,
          "description": "Pauses longer than this inside a line are shortened to it"
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "shot_size",
          "duration_s",
          "characters",
          "image_prompt",
          "seed",
          "motion",
          "narration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "beat": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why this shot exists"
          },
          "shot_size": {
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "medium_close_up",
              "close_up",
              "extreme_close_up",
              "insert"
            ]
          },
          "duration_s": {
            "type": "number",
            "minimum": 3,
            "maximum": 14,
            "description": "Minimum on-screen time; extended automatically if narration is longer"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_prompt": {
            "type": "string",
            "minLength": 20
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "motion": {
            "type": "object",
            "required": [
              "mode",
              "kenburns"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "kenburns",
                  "wan"
                ],
                "description": "wan = use a Wan 2.2 clip if one exists, else fall back to kenburns"
              },
              "kenburns": {
                "enum": [
                  "zoom_in",
                  "zoom_out",
                  "pan_left",
                  "pan_right",
                  "pan_up",
                  "static"
                ]
              },
              "video_prompt": {
                "type": "string",
                "description": "Motion and camera only; the image already holds the subject"
              },
              "vertical_fit": {
                "enum": [
                  "crop",
                  "blur"
                ],
                "description": "9:16 version: crop the centre (default) or fit the whole image over a blurred copy (group shots)"
              }
            }
          },
          "narration": {
            "type": "object",
            "required": [
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string",
                "description": "English source line; also the subtitle text"
              },
              "spoken": {
                "type": "string",
                "description": "Line in the narration language. Filled by the script stage unless locked"
              },
              "spoken_source_hash": {
                "type": "string",
                "description": "Hash of the English text the spoken line was translated from"
              },
              "locked": {
                "type": "boolean",
                "description": "true = a human corrected the spoken line; never re-translate"
              },
              "lead_in_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              }
            }
          },
          "people_count": {
            "type": "integer",
            "minimum": 0,
            "description": "How many people must be visible; checked with Gemini vision after generation, other seeds tried if wrong"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "caption",
        "bpm",
        "key",
        "duration_s",
        "candidates",
        "cues"
      ],
      "additionalProperties": false,
      "properties": {
        "caption": {
          "type": "string"
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "key": {
          "type": "string"
        },
        "duration_s": {
          "type": "number",
          "minimum": 30,
          "maximum": 120
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ],
          "description": "File name of the chosen candidate, e.g. cand_2.wav"
        },
        "chosen_reason": {
          "type": "string"
        },
        "music_db": {
          "type": "number",
          "description": "Music gain before ducking, dB"
        },
        "duck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number"
            },
            "ratio": {
              "type": "number"
            },
            "attack_ms": {
              "type": "number"
            },
            "release_ms": {
              "type": "number"
            }
          }
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "at_shot",
              "intent"
            ],
            "additionalProperties": false,
            "properties": {
              "at_shot": {
                "type": "string",
                "pattern": "^s[0-9]{2}$"
              },
              "intent": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": [
        "text",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "pattern": "(?i)AI"
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": {
          "type": "integer",
          "const": 24
        },
        "horizontal": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "vertical": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "target_lufs": {
          "type": "number"
        },
        "true_peak_db": {
          "type": "number"
        }
      }
    }
  }
}
